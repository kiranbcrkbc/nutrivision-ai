# ==============================================================================
# NutriVision AI - Frontend Environment Configuration Template
# Copy this file to .env or .env.local for local development
# ==============================================================================

# Backend Spring Boot API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# AI Microservice Base URL (Direct browser access if enabled for dev/debug)
VITE_AI_SERVICE_URL=http://localhost:8000/api/ai

# Application Environment Mode (development / production / staging)
VITE_APP_ENV=development

# Application Name
VITE_APP_NAME="NutriVision AI"

# Default UI Language Code (en, kn, hi, te, ta)
VITE_DEFAULT_LANGUAGE=en

# Feature Flags (true / false)
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_TEXT_TO_SPEECH=true
VITE_ENABLE_GRAD_CAM_VIEWER=true
VITE_ENABLE_MAPS=true
