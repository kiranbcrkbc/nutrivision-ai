# ==============================================================================
# NutriVision AI - Spring Boot Backend Environment Configuration Template
# Copy this file to .env or set environment variables in your local environment
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nutrivision_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Security and JWT Secret Configuration (Change for Production)
JWT_SECRET=change_this_to_a_secure_256_bit_secret_key_for_nutrivision_ai
JWT_EXPIRATION_MS=86400000

# AI/ML Microservice Connection
AI_SERVICE_BASE_URL=http://localhost:8000/api/ai
AI_SERVICE_TIMEOUT_MS=15000

# File Upload and Storage Paths (Local Filesystem)
APP_STORAGE_UPLOAD_DIR=./uploads/assessments
APP_STORAGE_TEMP_DIR=./uploads/temporary
APP_STORAGE_MAX_FILE_SIZE=10MB
APP_STORAGE_MAX_REQUEST_SIZE=25MB

# CORS Allowed Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Default Seed Configuration (Initial Dev Bootstrapping)
ADMIN_DEFAULT_EMAIL=admin@nutrivision.ai
ADMIN_DEFAULT_PASSWORD=AdminPasswordChangeMe123!
