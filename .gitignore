# ==============================================================================
# NutriVision AI - Git Ignore Configuration
# ==============================================================================

# Node.js / React / Vite
node_modules/
dist/
dist-ssr/
*.local
.npm/
.eslintcache
.stylelintcache
package-lock.json.bak

# Java / Spring Boot / Maven / Gradle
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
.gradle/
build/
bin/

# Python / FastAPI / AI Microservice
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Environment Configurations and Secrets (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12

# Database & Credentials
*.db
*.sqlite3
*.dump
*.sql.gz

# Uploaded User Images (Medical Privacy & Sensitive Data)
uploads/temporary/*
!uploads/temporary/.gitkeep
uploads/assessments/*
!uploads/assessments/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
scratch/*
!scratch/.gitkeep

# Heavy Datasets (Raw & Processed Image Files)
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep

# Trained Model Binaries
models/trained/*.h5
models/trained/*.keras
models/trained/*.pb
models/trained/*.tflite
models/experiments/*
!models/trained/.gitkeep
!models/trained/mobilenetv2_nutrivision_v1.onnx
!models/trained/model_metadata.json
!models/experiments/.gitkeep
!ai-service/models/trained/mobilenetv2_nutrivision_v1.onnx
!ai-service/models/trained/model_metadata.json

# Logs and Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Operating System Artifacts
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.DS_Store
Thumbs.db
desktop.ini
.venv-ai/
