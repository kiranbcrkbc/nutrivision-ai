# ==============================================================================
# NutriVision AI - FastAPI AI/ML Microservice Environment Configuration Template
# Copy this file to .env for local Python development
# ==============================================================================

# Application & Server Settings
APP_NAME="NutriVision AI ML Engine"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Model Storage and Registry Paths
MODELS_DIR=./models/trained
EXPERIMENTS_DIR=./models/experiments
ACTIVE_MODEL_VERSION=v1.0.0-mobilenetv2

# Image Quality Check Thresholds
BLUR_LAPLACIAN_THRESHOLD=100.0
MIN_BRIGHTNESS_LUMINANCE=40.0
MAX_BRIGHTNESS_LUMINANCE=220.0
MIN_IMAGE_WIDTH=224
MIN_IMAGE_HEIGHT=224

# Inference Parameters
DEFAULT_TOP_K=3
CONFIDENCE_INCONCLUSIVE_THRESHOLD=0.35

# CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Logging
LOG_LEVEL=INFO
